POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# Используется Alembic при локальном запуске (не в Docker).
# В docker compose DATABASE_URL собирается автоматически с хостом db.
DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@localhost:5432/taskflow

# Логирование (настраивается через env)
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s %(levelname)s [%(name)s] %(message)s"
# LOG_FILE=logs/taskflow.log
